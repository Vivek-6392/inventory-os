# Database Connection
# PostgreSQL (Production / Supabase / Local):
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/inventory_db
# SQLite (Local zero-config testing):
# DATABASE_URL=sqlite:///./inventory.db

# JWT Security
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
